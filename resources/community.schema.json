{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Firelight community directory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/entry"
      }
    }
  },
  "definitions": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^\\s]+$"
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "url"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/text"
        },
        "url": {
          "$ref": "#/definitions/url"
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "url"
      ],
      "properties": {
        "label": {
          "$ref": "#/definitions/text"
        },
        "url": {
          "$ref": "#/definitions/url"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "description",
        "url",
        "authors"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "$ref": "#/definitions/text"
        },
        "kind": {
          "enum": [
            "theme",
            "project"
          ]
        },
        "description": {
          "$ref": "#/definitions/text"
        },
        "url": {
          "$ref": "#/definitions/url"
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/author"
          }
        },
        "app": {
          "$ref": "#/definitions/text"
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "coal",
              "smoulder",
              "ash"
            ]
          }
        },
        "category": {
          "enum": [
            "editors",
            "terminals",
            "browsers",
            "desktop",
            "tools",
            "websites",
            "other"
          ]
        },
        "links": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/link"
          }
        },
        "notes": {
          "$ref": "#/definitions/text"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "theme"
              }
            }
          },
          "then": {
            "required": [
              "app",
              "variants"
            ]
          }
        }
      ]
    }
  }
}
