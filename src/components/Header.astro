---
import Wordmark from './Wordmark.astro';
import { sitePath } from '../lib/paths';
interface Props { current: 'palette' | 'playground' | 'community' }
const { current } = Astro.props;
const pages = [{ id: 'palette', label: 'Palette', path: '' }, { id: 'playground', label: 'Playground', path: 'playground/' }, { id: 'community', label: 'Community', path: 'community/' }];
---
<header class="site-header wrap">
  <a class="brand-link" href={sitePath()} aria-label="firelight palette"><Wordmark /></a>
  <nav class="site-nav" aria-label="Main navigation">
    {pages.map(page => <a href={sitePath(page.path)} aria-current={current === page.id ? 'page' : undefined}>{page.label}</a>)}
  </nav>
</header>

<style>
.site-header{display:flex;justify-content:space-between;align-items:center;gap:24px;padding-top:28px;padding-bottom:40px}
.brand-link{text-decoration:none;flex:none}.site-nav{display:flex;flex-wrap:wrap;gap:24px}
.site-nav a{font-size:12px;text-decoration:none;color:var(--ink-2);padding:8px 0}
.site-nav a[aria-current="page"]{color:var(--ink);text-decoration:underline;text-underline-offset:6px}
.site-nav a:hover{color:var(--site-rose)}
@media(max-width:600px){.site-header{align-items:flex-start;flex-direction:column;gap:14px;padding-top:24px;padding-bottom:28px}.site-nav{gap:24px}}
</style>
