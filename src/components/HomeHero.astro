---
import { cssVariable } from '../lib/colour';
const accents = ['rose', 'ember', 'coral', 'apricot', 'honey', 'fern', 'verdigris', 'cornflower', 'lilac'];
---
<section class="home-hero" aria-labelledby="home-title">
  <div class="hero-centre wrap">
    <h1 id="home-title" class="hero-wordmark" aria-label="firelight">{[...'firelight'].map((letter, index) => <span aria-hidden="true" style={['coal', 'smoulder', 'ash'].map(variant => '--letter-' + variant + ':var(' + cssVariable(variant, accents[index]) + ')').join(';')}>{letter}</span>)}</h1>
    <p>A colour palette for interfaces and code.</p>
  </div>
  <div class="hero-bottom wrap">
    <a class="hero-explore" href="#palettes">Explore the palettes <span aria-hidden="true">↓</span></a>
  </div>
</section>

<style>
.home-hero{position:relative;isolation:isolate;overflow:clip;min-height:max(500px,calc(100svh - var(--header-height)));display:grid;grid-template-rows:1fr auto;background:var(--fl-smoulder-bg1);color:var(--fl-smoulder-fg1)}
.home-hero .wrap{width:100%;min-width:0;position:relative;z-index:1}
.hero-centre{display:flex;flex-direction:column;justify-content:center;text-align:center;padding-top:100px;padding-bottom:116px}
.hero-wordmark{margin:0;font:700 clamp(42px,10vw,112px)/1.2 var(--mono);letter-spacing:-.055em;white-space:nowrap}
.hero-wordmark span{color:var(--letter-coal);animation:letter-colours 20s ease-in-out infinite}
.hero-centre p{margin:22px 0 0;font-size:clamp(11px,1.5vw,14px);line-height:1.7;color:var(--fl-smoulder-fg1);text-wrap:balance}
.home-hero a{color:inherit;text-decoration:none}
.home-hero a:hover{text-decoration:underline;text-underline-offset:6px}
.home-hero a:focus-visible{outline:2px solid currentColor;outline-offset:6px}
.hero-bottom{display:flex;align-items:center;justify-content:space-between;gap:24px;padding-top:24px;padding-bottom:36px;font-size:11px}
.hero-explore{display:inline-flex;align-items:center;gap:14px}
@keyframes letter-colours{
  0%,11.111%,100%{color:var(--letter-coal)}
  33.333%,44.444%{color:var(--letter-smoulder)}
  66.667%,77.778%{color:var(--letter-ash)}
}
@media(prefers-reduced-motion:reduce){
  .hero-wordmark span{animation:none}
}
@media(max-width:600px){
  .home-hero{min-height:max(420px,calc(100svh - var(--header-height)))}
  .hero-bottom{flex-wrap:wrap;gap:20px;padding-bottom:26px}
}
</style>
