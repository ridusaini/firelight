---
import { sitePath } from '../lib/paths';
---
<figure class="section-panel showcase" aria-labelledby="showcase-title">
  <figcaption id="showcase-title"><h2>Palette overview</h2><p>22 colours in each variant.</p></figcaption>
  <div class="showcase-scroll" tabindex="0" role="region" aria-label="Variant overview, scroll horizontally on smaller screens">
    <img src={sitePath("assets/overview.svg")} width="1180" height="348" alt="Coal, Smoulder, and Ash, each with six background colours, six text colours, and ten accents.">
  </div>
</figure>
