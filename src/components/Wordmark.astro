---
import { accentTokens } from '../lib/colour';
const letters = [...'firelight'].map((letter, index) => ({ letter, accent: accentTokens[index] }));
---
<p class="wordmark" aria-label="firelight"><span>{letters.map(({ letter, accent }) => <span style={'color:var(--site-' + accent + ')'}>{letter}</span>)}</span></p>

<style>
.wordmark{font:700 32px/.98 var(--mono);letter-spacing:-.035em;margin:0}
</style>
