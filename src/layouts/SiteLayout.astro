---
import palette, { siteVariant } from '../lib/palette';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { sitePath } from '../lib/paths';
import '../styles/global.css';
interface Props { title: string; description: string; current: 'palette' | 'playground' | 'community' }
const { title, description, current } = Astro.props;
---
<!doctype html>
<html lang="en" data-fl={siteVariant}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content={palette.variants[siteVariant].colors.bg1} />
  <meta name="color-scheme" content="dark" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <title>{title}</title>
  <link rel="stylesheet" href={sitePath('firelight.css')} />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header current={current} />
  <main id="main" tabindex="-1"><slot /></main>
  <Footer community={current === 'community'} />
  <div id="toast" role="status" aria-live="polite"></div>
</body>
</html>
